{
    "name": "entmoot",
    "version": "0.1.0",
    "description": "A read-only, skill-driven review harness",
    "type": "module",
    "bin": {
        "entmoot": "dist/main.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.19"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "prepare": "npm run build",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "format": "biome format --write",
        "format:check": "biome format"
    },
    "dependencies": {
        "@earendil-works/pi-ai": "^0.85.1",
        "@earendil-works/pi-coding-agent": "^0.85.1",
        "commander": "^15.0.0",
        "typebox": "^1.3.7",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@types/node": "^22.20.1",
        "typescript": "^5.7.0"
    }
}
