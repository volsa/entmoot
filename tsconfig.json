{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "types": ["node"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "sourceMap": true,
        "declaration": false,
        "skipLibCheck": true
    },
    "include": ["src"]
}
